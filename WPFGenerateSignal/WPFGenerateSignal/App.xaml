<Application x:Class="WPFGenerateSignal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WPFGenerateSignal.Resources.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Конвертеры -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:ParametersChangedToColorConverter x:Key="ParametersChangedToColorConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Typography.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ControlStyles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/LayoutStyles.xaml"/>
                
            <!-- Иконки-->
                <ResourceDictionary Source="Resources/Icons/GenerateIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>