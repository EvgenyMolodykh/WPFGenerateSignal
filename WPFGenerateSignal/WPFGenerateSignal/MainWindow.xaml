<Window x:Class="WPFGenerateSignal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPFGenerateSignal.Resources.Controls"
        xmlns:viewModels="clr-namespace:WPFGenerateSignal.ViewModels"
        xmlns:converters="clr-namespace:WPFGenerateSignal.Resources.Converters"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Генерация сигнала" 
        Height="770" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ParametersChangedToColorConverter x:Key="ParametersChangedToColorConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="ParametersChangedButtonStyle" 
               TargetType="Button" 
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ParametersChanged}" 
                             Value="True">
                    <Setter Property="Background" 
                            Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,16" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Генерация сигнала" 
                       Style="{StaticResource TitleTextStyle}"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                Margin="0,0,0,1" 
                Padding="20,16">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button Command="{Binding StartGenerationCommand}"
                Style="{StaticResource ParametersChangedButtonStyle}"
                IsEnabled="{Binding CanGenerate}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource save_energy_svgrepo_com__1_DrawingImage}" 
                          Width="26" 
                          Height="26"
                          Margin="0,0,5,0"/>
                        <TextBlock Text="Сгенерировать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Content="Отменить" 
                Command="{Binding CancelGenerationCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                IsEnabled="{Binding IsGenerating}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ProgressBar Value="{Binding GenerationProgress}" 
                             Margin="15,0,0,0"
                            Width="200" 
                            Style="{StaticResource ProgressBarStyle}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Text="{Binding GenerationProgress, StringFormat={}{0:F0}%}"
                          Style="{StaticResource BodyTextStyle}"
                          VerticalAlignment="Center"
                          MinWidth="40"
                          Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource TabControlStyle}">

            <TabItem Header="📊 Генерация" Style="{StaticResource TabItemStyle}">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <GroupBox Style="{StaticResource GroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock Text="Основные параметры" Style="{StaticResource GroupBoxHeaderStyle}"/>
                                </GroupBox.Header>
                                <StackPanel Margin="16,8">
                                    <TextBlock Text="Тип сигнала:" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>
                                    <ComboBox SelectedItem="{Binding SelectedSignalType}" 
                                             Style="{StaticResource ComboBoxStyle}"
                                             Margin="0,0,0,16">
                                        <sys:String>Синусоида</sys:String>
                                        <sys:String>Меандр</sys:String>
                                        <sys:String>Треугольный</sys:String>
                                        <sys:String>Пилообразный</sys:String>
                                    </ComboBox>

                                    <CheckBox Content="Наложение сигналов" 
                                             IsChecked="{Binding IsSignalOverlayEnabled}"
                                             Style="{StaticResource CheckBoxStyle}"
                                             Margin="0,0,0,12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource GroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock Text="Параметры сигнала" Style="{StaticResource GroupBoxHeaderStyle}"/>
                                </GroupBox.Header>
                                <StackPanel Margin="16,8">
                                    <TextBlock Text="Амплитуда:" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="0.1" Maximum="5.0" Value="{Binding Amplitude}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Amplitude, StringFormat={}{0:F1}}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Частота (Гц):" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="0.1" Maximum="10.0" Value="{Binding Frequency}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Frequency, StringFormat={}{0:F1} Гц}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Фаза (рад):" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="0" Maximum="6.28" Value="{Binding Phase}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Phase, StringFormat={}{0:F2} рад}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Количество точек:" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="100" Maximum="10000" Value="{Binding PointsCount}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding PointsCount}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource GroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock Text="Обработка сигнала" Style="{StaticResource GroupBoxHeaderStyle}"/>
                                </GroupBox.Header>
                                <StackPanel Margin="16,8">
                                    <CheckBox Content="Нормализация сигнала" 
                                             IsChecked="{Binding IsNormalizationEnabled}"
                                             Style="{StaticResource CheckBoxStyle}"
                                             Margin="0,0,0,8"/>

                                    <CheckBox Content="Применить оконную функцию" 
                                             IsChecked="{Binding IsWindowFunctionEnabled}"
                                             Style="{StaticResource CheckBoxStyle}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Margin="16" CornerRadius="8">
                        <Grid>
                            
                            <local:SinusoidControl 
                                Visibility="{Binding IsSinusoidSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:MeandrControl 
                                Visibility="{Binding IsMeandrSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:TriangleControl 
                                Visibility="{Binding IsTriangleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:SawtoothControl 
                                Visibility="{Binding IsSawtoothSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🎛️ Фильтрация" Style="{StaticResource TabItemStyle}">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <GroupBox Style="{StaticResource GroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock Text="Параметры фильтра" Style="{StaticResource GroupBoxHeaderStyle}"/>
                                </GroupBox.Header>
                                <StackPanel Margin="16,8">
                                    <TextBlock Text="Тип фильтра:" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding FilterTypes}" 
                                             SelectedItem="{Binding SelectedFilterType}" 
                                             Style="{StaticResource ComboBoxStyle}"
                                             Margin="0,0,0,16"/>

                                    <TextBlock Text="Частота среза (Гц):" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="0.1" Maximum="10.0" Value="{Binding CutoffFrequency}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding CutoffFrequency, StringFormat={}{0:F1} Гц}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Порядок фильтра:" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                    <Slider Minimum="1" Maximum="10" Value="{Binding FilterOrder}" 
                                           Style="{StaticResource SliderStyle}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding FilterOrder}" 
                                              Style="{StaticResource CaptionTextStyle}" 
                                              HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                        <Button Content="Применить фильтр" 
                                               Command="{Binding ApplyFilterCommand}"
                                               Style="{StaticResource PrimaryButtonStyle}"
                                               Padding="12,8"/>

                                        <Button Content="Удалить фильтр" 
                                               Command="{Binding RemoveFilterCommand}"
                                               Style="{StaticResource SecondaryButtonStyle}"
                                               Padding="12,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Style="{StaticResource GroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock Text="Статистика сигнала" Style="{StaticResource GroupBoxHeaderStyle}"/>
                                </GroupBox.Header>
                                <StackPanel Margin="16,8">
                                    <TextBlock Text="{Binding SignalStatistics.MaxValue, StringFormat='Максимум: {0:F3}'}" 
                                              Style="{StaticResource BodyTextStyle}" Margin="0,2"/>
                                    <TextBlock Text="{Binding SignalStatistics.MinValue, StringFormat='Минимум: {0:F3}'}" 
                                              Style="{StaticResource BodyTextStyle}" Margin="0,2"/>
                                    <TextBlock Text="{Binding SignalStatistics.MeanValue, StringFormat='Среднее: {0:F3}'}" 
                                              Style="{StaticResource BodyTextStyle}" Margin="0,2"/>
                                    <TextBlock Text="{Binding SignalStatistics.RMSValue, StringFormat='СКЗ: {0:F3}'}" 
                                              Style="{StaticResource BodyTextStyle}" Margin="0,2"/>
                                    <TextBlock Text="{Binding SignalStatistics.StandardDeviation, StringFormat='Ст. отклонение: {0:F3}'}" 
                                              Style="{StaticResource BodyTextStyle}" Margin="0,2"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Margin="16" CornerRadius="8">
                        <Grid>
                            
                            <local:SinusoidControl 
                                Visibility="{Binding IsSinusoidSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:MeandrControl 
                                Visibility="{Binding IsMeandrSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:TriangleControl 
                                Visibility="{Binding IsTriangleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <local:SawtoothControl 
                                Visibility="{Binding IsSawtoothSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

       
            <TabItem Header="📈 Спектр" Style="{StaticResource TabItemStyle}">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Вкладка спектрального анализа" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>

            <TabItem Header="💾 База данных" Style="{StaticResource TabItemStyle}">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="15,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="💾 Сохранить в БД" 
                                    Command="{Binding SaveSignalToDatabaseCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="5,0"/>

                            <Button Content="📥 Загрузить из БД" 
                                    Command="{Binding LoadSignalsFromDatabaseCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="5,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                        <ItemsControl ItemsSource="{Binding LoadedSignals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Margin="0,5" 
                                            Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" 
                                                           Style="{StaticResource BodyTextStyle}" 
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SignalType}" 
                                                           Style="{StaticResource CaptionTextStyle}" 
                                                           Foreground="{StaticResource SecondaryBrush}"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}" 
                                                           Style="{StaticResource CaptionTextStyle}"/>
                                                <TextBlock Text="{Binding Points.Count, StringFormat='Точек: {0}'}" 
                                                           Style="{StaticResource CaptionTextStyle}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Amplitude, StringFormat='A: {0:F2}'}" 
                                                               Style="{StaticResource CaptionTextStyle}" 
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Frequency, StringFormat='F: {0:F2} Гц'}" 
                                                               Style="{StaticResource CaptionTextStyle}" 
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Phase, StringFormat='φ: {0:F2} рад'}" 
                                                               Style="{StaticResource CaptionTextStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="10,5">
                        <TextBlock Text="{Binding StatusMessage}" 
                                  Style="{StaticResource CaptionTextStyle}"
                                  HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Margin="0,1,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="💾 Сохранить в БД" 
                        Command="{Binding SaveSignalToDatabaseCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanSaveSignal}"/>

                <Button Content="📤 Экспорт" 
                        Command="{Binding ExportDataCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="📥 Импорт" 
                        Command="{Binding ImportDataCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

            </StackPanel>
        </Border>

        <StatusBar Grid.Row="4" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding PointsCount, StringFormat='Точек: {0}'}" 
                          Style="{StaticResource CaptionTextStyle}" Margin="16,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>